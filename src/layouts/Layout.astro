---
import Footer from "@/components/Footer.astro";
import "@/styles/globals.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Ronish</title>
    <meta name="description" content="ronish rohan's portfolio" />
    <meta name="keywords" content="ronish, rohan, ronish rohan, portfolio, developer, projects, skills, contact" />
    <meta name="author" content="Ronish Rohan" />
    <meta property="og:title" content="ronish rohan" />
    <meta property="og:description" content="portfolio" />
    <!-- <meta property="og:image" content="/path/to/og-image.jpg" /> -->
    <meta property="og:url" content="https://ronish.dev" />
    <!-- <meta name="twitter:card" content="summary_large_image" /> -->
    <meta name="twitter:title" content="ronish rohan" />
    <meta name="twitter:description" content="portfolio" />
    
    <!-- <meta name="twitter:image" content="/path/to/twitter-image.jpg" /> -->
  </head>
  <body class="dark font-geist flex items-center h-fit min-h-dvh justify-center flex-col">
    <div
      class="flex relative dark flex-col w-full p-4 md:p-0  md:w-[600px] min-h-dvh h-fit  md:!py-14 text-sm select-none"
    >
      <div class="size-full flex flex-col" ><slot /></div>
      <Footer />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
