---
import "../styles/base.css"
import { ViewTransitions } from "astro:transitions"

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title: pageTitle,
  description: pageDesc,
  path = "",
} = Astro.props;

const defaultTitle = "ronish rohan - developer & designer";
const defaultDesc = "hi, i'm ronish rohan, a 21 year old developer and designer from bengaluru (bangalore), india. currently a founding engineer at ghost (tryghost.ai). i love designing and developing websites and apps.";

const title = pageTitle ? `${pageTitle} — ronish` : defaultTitle;
const description = pageDesc ?? defaultDesc;
const siteUrl = "https://ronish.dev";
const canonicalUrl = `${siteUrl}${path}`;
const ogImage = siteUrl;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="ronish, ronish rohan, developer, designer, bengaluru, india, ghost, tryghost.ai" />
    <meta name="author" content="ronish rohan" />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="ronish.dev" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@ronish1o" />

    <meta name="theme-color" content="#ffffff" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" id="favicon" type="image/png" href="" />
    <ViewTransitions />
    <style>
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
      }
    </style>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Ronish Rohan",
      "alternateName": ["ronish", "ronish1o"],
      "url": "https://ronish.dev",
      "sameAs": [
        "https://github.com/ronishrohan",
        "https://x.com/ronish1o",
        "https://instagram.com/ronish1o"
      ],
      "jobTitle": "Founding Engineer",
      "worksFor": {
        "@type": "Organization",
        "name": "Ghost",
        "url": "https://tryghost.ai"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Bengaluru",
        "addressCountry": "India"
      }
    }
    </script>
  </head>
  <body>
    <div transition:persist class="fixed size-full z-[2000000] pointer-events-none opacity-15 mix-blend-multiply flex items-end justify-center" >
      <video src="/leaves.mp4" autoplay muted loop class="h-fit w-full object-cover"></video>
    </div>
    <slot />
    <script>
      const colors = [
        "#ea580c", // orange (site accent)
        "#2563eb", // blue
        "#16a34a", // green
        "#dc2626", // red
        "#7c3aed", // violet
        "#0891b2", // cyan
        "#d97706", // amber
        "#db2777", // pink
        "#059669", // emerald
        "#9333ea", // purple
      ];

      // Pick once per hard refresh; window persists across view-transition navigations
      if (!(window as any).__accent) {
        (window as any).__accent = colors[Math.floor(Math.random() * colors.length)];
      }

      function applyAccent() {
        document.documentElement.style.setProperty("--accent", (window as any).__accent);
      }

      applyAccent();
      document.addEventListener("astro:after-swap", applyAccent);

      const startIndex = colors.indexOf((window as any).__accent);
      let index = (window as any).__faviconIndex ?? (startIndex >= 0 ? startIndex : 0);

      function drawCircle(color: string) {
        const canvas = document.createElement("canvas");
        canvas.width = 64;
        canvas.height = 64;
        const ctx = canvas.getContext("2d")!;
        ctx.beginPath();
        ctx.arc(32, 32, 32, 0, Math.PI * 2);
        ctx.fillStyle = color;
        ctx.fill();
        return canvas.toDataURL("image/png");
      }

      function setColor(color: string) {
        const link = document.getElementById("favicon") as HTMLLinkElement;
        if (link) link.href = drawCircle(color);
        const dot = document.getElementById("nav-dot") as HTMLElement;
        if (dot) dot.style.background = color;
      }

      // Clear any previous cycle before starting a new one
      clearTimeout((window as any).__faviconTimeout);

      function cycle() {
        setColor(colors[index % colors.length]);
        (window as any).__faviconIndex = ++index;
        (window as any).__faviconTimeout = setTimeout(cycle, 800);
      }

      cycle();
    </script>
  </body>
</html>
