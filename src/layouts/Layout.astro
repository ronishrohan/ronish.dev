---
import Footer from "@/components/Footer.astro";
import "@/styles/globals.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Ronish</title>
  </head>
  <body class="dark font-geist flex items-center justify-center flex-col">
    <div
      class="flex relative dark flex-col w-full p-4 md:p-0 md:w-[600px] min-h-dvh h-fit !pt-0 md:!py-14 text-sm select-none"
    >
      <div class="size-full flex flex-col" ><slot /></div>
      <Footer />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
