---
const baseNames = [
  "ronish",
  "रोनीश",
  "ರೋನಿಶ್",
  "రోనిష్",
  "റോണിഷ്",
  "ரோனிஷ்",
  "رونش",
  
];

const names = [
  ...baseNames,
  ...baseNames,
  "ronish",
];
---

<div class="flex justify-between" >
  <span class="name-display text-2xl">ronish</span>
  <div class="flex gap-2 items-center *:hover:underline *:hover:text-zinc-900 text-zinc-500" >
    <a href="https://github.com/ronishrohan" target="_blank" >
      github
    </a>
    <a href="https://x.com/ronish1o" target="_blank" >
      twitter
    </a>
    <a href="https://instagram.com/ronish1o" target="_blank" >
      instagram
    </a>
    <a href="https://discord.com/users/769140296939470859" target="_blank" >
      discord
    </a>
  </div>
</div>

<script define:vars={{ names }}>
  const el = document.querySelector(".name-display");
  
  let delay = 40;
  const deceleration = 1.19;
  let index = 1;

  function showNext() {
    if (index >= names.length) return;
    
    el.textContent = names[index];
    index++;
    delay *= deceleration;
    
    setTimeout(showNext, delay);
  }

  setTimeout(showNext, delay);
</script>
