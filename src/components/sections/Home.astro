---
import Footer from "../Footer.astro";
import { Button } from "../ui/button";
import {
  Card,
  CardHeader,
  CardTitle,
  CardFooter,
  CardContent,
} from "../ui/card";
import Chip from "../ui/Chip.astro";
import Title from "../ui/Title.astro";
const works = [
  { name: "Waffle", href:"#" },
  { name: "Reddit Clone", href:"#" },
  { name: "Portfolio website", href:"#" },
  { name: "Something", href:"#" },
  { name: "Something", href:"#" },
];
---

<section class="flex flex-col w-full p-4 md:p-0 md:w-[600px] h-dvh md:h-[90vh] text-sm select-none">
  <div class="h-fit w-full flex relative gap-4 items-center">
    <div
      class="size-[45px] border-border border-2 rounded-sm flex items-center justify-center !stroke-accent-foreground/50"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke=""
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-disc-3 animate-spin"
        ><circle cx="12" cy="12" r="10"></circle><path
          d="M6 12c0-1.7.7-3.2 1.8-4.2"></path><circle cx="12" cy="12" r="2"
        ></circle><path d="M18 12c0 1.7-.7 3.2-1.8 4.2"></path></svg
      >
    </div>
    <div>
      <div class="">Ronish</div>
      <div class="text-foreground/50">Developer</div>
    </div>
  </div>
  <div class="py-4 text-sm flex flex-col">
    <div>
      Loves creating <span
        class="italic cursor-pointer text-primary-foreground hover:font-black transition-all duration-75 underline hover:text-primary"
        >stuff</span
      >
    </div>
    <div>
      Lives in <span
        class="italic cursor-pointer text-primary-foreground hover:font-black transition-all duration-75 underline hover:text-primary"
        >Bangalore, India</span
      >
    </div>
    <div>Likes a little bit of everything</div>
    <div>This website was meant to be simple,</div>
    <div>
      I've made <span
        class="italic cursor-pointer text-primary-foreground hover:font-black transition-all duration-75 underline hover:text-primary"
        >too many</span
      > of them
    </div>
  </div>
  <div class="flex flex-col h-fit w-full">
    <Title title="Work" />
    <div class="size-full flex flex-col py-1">
      {
        works.map((work, index) => (
          <a
            href={work.href}
            class=" py-1 hover:font-bold hover:text-primary focus:text-primary focus:bg-accent outline-none focus:font-bold transition-all duration-75 px-1 w-full rounded-sm hover:bg-accent"
          >
            0{index} {work.name}
          </a>
        ))
      }
    </div>
  </div>
  <div class="flex flex-col size-full">
    <Title title="Skills" />
    <div class="size-full flex flex-col py-1">
      
    </div>
  </div>
  <Footer />
</section>
