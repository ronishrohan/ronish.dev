---
// import { Mail } from "lucide-astro";
import { Github, Linkedin, Mail, Twitter } from "lucide-react";
import Accordion from "../Accordion";
import { Button } from "../ui/button";

import Title from "../ui/Title.astro";

const works = [
  { name: "Waffle", href: "#" },
  { name: "Reddit Clone", href: "#" },
  { name: "Landing page", href: "#" },
  { name: "Portfolio website", href: "#" },
  { name: "Paypeek", href: "#" },
];
---

<section class="h-full flex flex-col">
  <div class="h-fit w-full flex relative gap-4 items-center">
    <div
      class="size-[45px] border-border border-2 rounded-sm flex items-center justify-center !stroke-accent-foreground/50"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke=""
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-disc-3 animate-spin"
        ><circle cx="12" cy="12" r="10"></circle><path
          d="M6 12c0-1.7.7-3.2 1.8-4.2"></path><circle cx="12" cy="12" r="2"
        ></circle><path d="M18 12c0 1.7-.7 3.2-1.8 4.2"></path></svg
      >
    </div>
    <div class="flex flex-col">
      <h1 class="font-normal">
        Ronish <span class="text-foreground/70">Rohan</span>
      </h1>
      <div class="text-foreground/50 font-medium">Developer</div>
    </div>
  </div>
  <div class="py-4 text-sm flex flex-col">
    <div>
      I love creating <span
        class="italic cursor-pointer text-primary-foreground hover:font-black transition-all duration-75 underline hover:text-primary"
        >shit</span
      >
    </div>
    <div>
      Based in <a
        href="/gallery"
        class="italic cursor-pointer text-primary-foreground hover:font-black transition-all duration-75 underline hover:text-primary"
        >Bangalore, India</a
      >
    </div>
    <!-- <div>Likes a little bit of everything</div> -->
    <div class="mt-4">This website was meant to be simple,</div>
    <div>
      I've made <span
        class="italic cursor-pointer text-primary-foreground hover:font-black transition-all duration-75 underline hover:text-primary"
        >too many</span
      > of them
    </div>
  </div>

  <Accordion title="About" client:load
    ><div>
      Hi, I'm Ronish Rohan, a CS student from Bangalore, India. Currently I am
      in my second year, and I'm interested in anything that has to do with
      websites and design. <br /> I have previously worked as a 3D graphics artist
      for about 3 years and I still continue to do graphics as a hobby.
    </div></Accordion
  >
  <Accordion title="Projects" client:load>
    <div class="flex flex-col">
      {
        works.map((work, index) => (
          <a
            href={work.href}
            class=" py-1 hover:font-bold hover:text-primary focus:text-primary focus:bg-accent-foreground/10 outline-none focus:font-bold  px-1 w-full rounded-sm hover:bg-accent"
          >
            0{index} {work.name}
          </a>
        ))
      }
    </div>
  </Accordion>
  <Accordion client:load  title="Skills">
    <div class="flex flex-col"></div>
  </Accordion>
  <Accordion client:load  title="Contact">
    <div class="grid grid-cols-2">
      <Button variant="ghost" className="w-full">
        <Mail />
      </Butt>
      <Button variant="ghost" className="w-full">
        <Linkedin />
      </Button>
      <Button variant="ghost" className="w-full">
        <Twitter />
      </Button>
      <Button variant="ghost" className="w-full">
        <Github />
      </Button>
    </div>
  </Accordion>

  <!-- <div class="flex flex-col h-fit mt-auto">
    <Title title="Links" />
    <div class="w-full h-fit gap-1 flex py-1">
      <Button variant="ghost" className="w-full">
        
        <Mail />
      </Button>
      <Button variant="ghost" className="w-full">
        <LinkedinIcon />
      </Button>
      <Button variant="ghost" className="w-full">
        <Twitter />
      </Button>
      <Button variant="ghost" className="w-full">
        <Github />
      </Button>
    </div>
  </div> -->
</section>
