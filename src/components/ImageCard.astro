---
import { Image } from "astro:assets"

const {height, width, src} = Astro.props
---
<div style={{
    height: `${height}`,
    width: `${width}`,
}} class=" rounded-sm bg-foreground relative overflow-hidden flex items-center justify-center" >
<Image height={1000} width={1000}  src={src} class="size-full absolute object-cover left-0 top-0" alt=""></div>