---
const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
const isBlog = currentPath.startsWith("/blog");
---

<nav transition:persist class="w-full flex justify-center">
  <div class="max-w-4xl w-full flex justify-between items-center px-6 pt-8">
    <a href="/" class="text-base text-black">ronish.dev</a>
    <div class="flex gap-1 text-base">
      <a
        href="/"
        data-nav="home"
        class:list={["px-2 py-0.5", isHome ? "bg-orange-600 text-white" : "text-zinc-400 hover:bg-zinc-100"]}
      >
        home
      </a>
      <a
        href="/blog"
        data-nav="blog"
        class:list={["px-2 py-0.5", isBlog ? "bg-orange-600 text-white" : "text-zinc-400 hover:bg-zinc-100"]}
      >
        writing
      </a>
    </div>
  </div>
</nav>

<script>
  function updateNav() {
    const path = window.location.pathname;
    const isHome = path === "/";
    const isBlog = path.startsWith("/blog");

    const homeLink = document.querySelector<HTMLAnchorElement>('[data-nav="home"]');
    const blogLink = document.querySelector<HTMLAnchorElement>('[data-nav="blog"]');

    if (!homeLink || !blogLink) return;

    homeLink.className = `px-2 py-0.5 ${isHome ? "bg-orange-600 text-white" : "text-zinc-400 hover:bg-zinc-100"}`;
    blogLink.className = `px-2 py-0.5 ${isBlog ? "bg-orange-600 text-white" : "text-zinc-400 hover:bg-zinc-100"}`;
  }

  document.addEventListener("astro:page-load", updateNav);
</script>
