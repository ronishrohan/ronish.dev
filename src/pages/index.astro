---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Title from "../components/Title.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const allPosts = await getCollection("blog", ({ data }: CollectionEntry<"blog">) => !data.draft);
const recentPosts = allPosts
  .sort((a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).toLocaleLowerCase();
}
---

<Layout>
  <Nav />

  <div class="flex flex-1 w-full flex-col bg-linear-to-b ">
    <div class="max-w-4xl w-full mx-auto text-base mt-[100px] flex flex-col gap-4 px-6">
      <Title />
      <div>
        this is ronish, im 21 and i live in bengaluru, india <br />

        i love designing and developing websites and apps <br /><br />
        i feel like websites need to be treated as an art for m and not just a tool
        to be used for marketing or selling products, that is why every one of my
        projects is unique and has a personal touch to it <br />
        "to create is to live twice" - albert camus
        <br /><br />
        i'm currently a software engineer at <a
          href="https://tryghost.ai"
          target="_blank"
          class="underline accent-hover">ghost</a
        >, we create extremely powerful agents for your computer
      </div>

      {recentPosts.length > 0 && (
        <div class="mt-6 flex flex-col gap-3">
          <span class="font-pixel text-zinc-400">recent writing</span>
          <div class="flex flex-col gap-1">
            {recentPosts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="flex relative justify-between items-center gap-4 group py-0.5"
              >
                <div class="absolute accent-bg pointer-events-auto group-hover:opacity-100 opacity-0 h-[calc(100%+8px)] w-[calc(100%+16px)]   translate-x-[-8px] translate-y-[0px]" ></div>
                <span class=" z-20 group-hover:text-white">
                  {post.data.title}
                </span>
                <span class="font-pixel text-base z-20  group-hover:text-white text-zinc-400 shrink-0">
                  {formatDate(post.data.date)}
                </span>
              </a>
            ))}
          </div>
          <a href="/blog" class="text-zinc-400 accent-hover w-fit">
            all posts →
          </a>
        </div>
      )}

    </div>

    <Footer />
  </div>
</Layout>
