---
import Layout from "../layouts/Layout.astro";
import Title from "../components/Title.astro";
import Image from "astro/components/Image.astro";
import monki from "../assets/monki.png";
---

<Layout>
  <!-- <div class="w-full h-14 flex justify-center items-stretch" >
		<div class="max-w-4xl w-full flex items-stretch" >
			<div class="flex items-center justify-center text-lg" >ronish</div>
		</div>
	</div> -->

  <div class="flex flex-col h-fit">
    <div
      class="max-w-4xl w-full mx-auto text-lg mt-[140px] flex flex-col gap-4"
    >
      <Title />
      <div>
        this is ronish, im 21 and i live with my parents in bengaluru, india <br
        />

        i love designing and developing websites and apps <br /><br />
        i feel like websites need to be treated as an art form and not just a tool
        to be used for marketing or selling products, that is why every one of my
        projects is unique and has a personal touch to it <br />
        "to create is to live twice" - albert camus
        <br /><br />
        i'm currently a founding engineer at <a
          href="https://tryghost.ai"
          target="_blank"
          class="underline hover:text-stone-600">ghost</a
        >, we create extremely powerful agents for your computer
      </div>
    </div>
    <div
      class="w-full max-h-[300px] overflow-hidden flex items-end justify-center mt-24 relative"
    >
      <div
        class="h-[20px] bg-linear-to-b from-transparent to-black w-full absolute bottom-0 z-[1000]"
      >
      </div>
      <Image src={monki} alt="Monki" />
    </div>
    <div class="h-fit pb-[12px] w-full bg-black text-white flex">
      <div class="max-w-4xl w-full flex flex-col items-baseline mx-auto">
        <div id="see-you-again" class="flex text-[40px] max-h-[80px]  overflow-visible justify-between w-full items-start">
          <div>see</div>
          <div>you</div>
          <div>again</div>
        </div>
		<div id="scroll-trap" class="h-[100px]" ></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // ===== CONFIGURABLE VALUES =====
  const START_FONT_SIZE = 40;  // px - starting font size
  const END_FONT_SIZE = 100;    // px - font size at max scroll
  // ================================

  const trap = document.getElementById('scroll-trap')!;
  const seeYouAgain = document.getElementById('see-you-again')!;
  let isAnimating = false;
  let scrollTimeout: ReturnType<typeof setTimeout> | null = null;

  // GSAP scroll-based font size animation
  gsap.to(seeYouAgain, {
    fontSize: `${END_FONT_SIZE}px`,
    scrollTrigger: {
      trigger: trap,
      start: "top bottom",
      end: "bottom bottom",
      scrub: true,
    }
  });

  function checkAndBounce() {
    if (isAnimating) return;
    
    const trapRect = trap.getBoundingClientRect();
    const triggerPoint = window.innerHeight;
    
    // If top of trap is visible (above bottom of viewport)
    if (trapRect.top < triggerPoint) {
      isAnimating = true;
      const targetScroll = trap.offsetTop - window.innerHeight;
      window.scrollTo({
        top: targetScroll,
        behavior: 'smooth'
      });
      setTimeout(() => {
        isAnimating = false;
      }, 800);
    }
  }

  window.addEventListener('scroll', () => {
    if (isAnimating) return;
    if (scrollTimeout) clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(checkAndBounce, 150);
  });

  // Also check on scroll end for when at very bottom
  window.addEventListener('scrollend', checkAndBounce);
</script>
