---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<Layout title="writing" description="notes on building things, on design, on whatever." path="/blog">
  <Nav />

  <div class="flex flex-1 w-full flex-col">
    <div class="max-w-4xl w-full mx-auto text-base mt-[100px] flex flex-col gap-4 px-6">

      <span class="font-pixel">writing</span>

      {posts.length === 0 ? (
        <p class="text-zinc-400">nothing here yet</p>
      ) : (
        <div class="flex flex-col mt-2">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="flex relative justify-between items-center gap-6 py-3 border-b border-zinc-100 group"
            >
              <div class="absolute bg-orange-600 pointer-events-none group-hover:opacity-100 opacity-0 h-[calc(100%+8px)] w-[calc(100%+16px)] translate-x-[-8px]"></div>
              <div class="flex flex-col gap-0.5 min-w-0 z-20">
                <span class="group-hover:text-white">
                  {post.data.title}
                </span>
                {post.data.description && (
                  <span class="text-base text-zinc-400 group-hover:text-orange-200">
                    {post.data.description}
                  </span>
                )}
              </div>
              <span class="font-pixel text-base text-zinc-400 group-hover:text-white shrink-0 z-20">
                {formatDate(post.data.date)}
              </span>
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="w-full mt-auto pb-2 bg-black text-white flex">
      <div class="max-w-4xl h-full w-full flex flex-col items-baseline mx-auto px-6">
        <div class="flex font-pixel text-[40px] h-full items-end justify-between w-full">
          <div>see</div>
          <div>you</div>
          <div>again</div>
        </div>
      </div>
    </div>
  </div>
</Layout>
