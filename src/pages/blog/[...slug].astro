---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.date.toISOString(),
  "author": {
    "@type": "Person",
    "name": "Ronish Rohan",
    "url": "https://ronish.dev"
  },
  "url": `https://ronish.dev/blog/${post.id}`,
  "publisher": {
    "@type": "Person",
    "name": "Ronish Rohan",
    "url": "https://ronish.dev"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://ronish.dev/blog/${post.id}`
  }
};

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.id}`}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  keywords={`${post.data.title}, ronish rohan, ronish.dev, blog, developer`}
>
  <Nav />

  <div class="flex flex-1 w-full flex-col">
    <article class="max-w-4xl w-full mx-auto px-6 mt-[100px] flex flex-col gap-4">
      <a id="back-link" href="/blog" class="font-pixel text-sm text-zinc-400 hover:text-black">
        ← writing
      </a>
      <h1 class="font-pixel text-2xl mt-2">{post.data.title}</h1>
      <span class="font-pixel text-sm text-zinc-400">
        {formatDate(post.data.date)}
      </span>

      <div class="flex gap-2 items-center">
        <!-- Font toggle: standalone button, no border wrapper -->
        
        <!-- Size toggle: default (left) + two bigger steps -->
        <div class="border border-zinc-200 p-1 flex">
          <button id="size-df" class="reading-btn w-8 h-8 flex items-center justify-center text-zinc-400 leading-none" style="font-size:0.7rem">aA</button>
          <button id="size-md" class="reading-btn w-8 h-8 flex items-center justify-center text-zinc-400 leading-none" style="font-size:0.85rem">aA</button>
          <button id="size-lg" class="reading-btn w-8 h-8 flex items-center justify-center text-zinc-400 leading-none" style="font-size:1rem">aA</button>
        </div>
        <div class="p-1 border border-zinc-200"><button id="font-toggle" title="Toggle font" class="border border-zinc-200 reading-btn w-8 h-8 flex items-center justify-center text-zinc-400">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor">
            <polygon points="16 11 16 13 15 13 15 14 14 14 14 15 13 15 13 16 11 16 11 15 10 15 10 14 9 14 9 13 8 13 8 11 10 11 10 10 11 10 11 8 13 8 13 9 14 9 14 10 15 10 15 11 16 11"/>
            <path d="m22,11v-2h-1v-1h-1v-1h-1v-1h-2v-1H7v1h-2v1h-1v1h-1v1h-1v2h-1v2h1v2h1v1h1v1h1v1h2v1h10v-1h2v-1h1v-1h1v-1h1v-2h1v-2h-1Zm-4,2h-1v2h-1v1h-1v1h-2v1h-2v-1h-2v-1h-1v-1h-1v-2h-1v-2h1v-2h1v-1h1v-1h2v-1h2v1h2v1h1v1h1v2h1v2Z"/>
          </svg>
        </button></div>
      </div>

      <div id="prose-content" class="prose mt-2" style="font-size:1rem">
        <Content />
      </div>

      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

      <script>
        function getAccent() {
          return getComputedStyle(document.documentElement).getPropertyValue("--accent").trim() || "#ea580c";
        }

        function initBlogControls() {
          const link = document.getElementById("back-link") as HTMLAnchorElement;
          if (link) {
            const ref = document.referrer;
            if (ref) {
              const url = new URL(ref);
              if (url.origin === window.location.origin && url.pathname === "/") {
                link.href = "/";
                link.textContent = "← home";
              }
            }
          }

          const prose = document.getElementById("prose-content") as HTMLElement;
          const fontToggle = document.getElementById("font-toggle") as HTMLButtonElement;
          const dfBtn = document.getElementById("size-df") as HTMLButtonElement;
          const mdBtn = document.getElementById("size-md") as HTMLButtonElement;
          const lgBtn = document.getElementById("size-lg") as HTMLButtonElement;

          if (!prose || !fontToggle || !dfBtn) return;

          function activate(btn: HTMLButtonElement) {
            btn.style.background = getAccent();
            btn.style.color = "white";
          }
          function deactivate(btn: HTMLButtonElement) {
            btn.style.background = "";
            btn.style.color = "";
          }

          // Font
          let usingInter = localStorage.getItem("blog-font") === "inter";

          function applyFont(inter: boolean) {
            if (inter) {
              if (!document.getElementById("inter-font-link")) {
                const l = document.createElement("link");
                l.id = "inter-font-link";
                l.rel = "stylesheet";
                l.href = "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap";
                document.head.appendChild(l);
              }
              prose.style.fontFamily = "'Inter', sans-serif";
              activate(fontToggle);
            } else {
              prose.style.fontFamily = "";
              deactivate(fontToggle);
            }
          }

          applyFont(usingInter);

          fontToggle.addEventListener("click", () => {
            usingInter = !usingInter;
            localStorage.setItem("blog-font", usingInter ? "inter" : "pixel");
            applyFont(usingInter);
          });

          // Size
          const sizeBtns = [dfBtn, mdBtn, lgBtn];
          const sizes = ["1rem", "1.125rem", "1.25rem"];
          const savedSize = localStorage.getItem("blog-size");
          const savedIndex = savedSize ? sizes.indexOf(savedSize) : 0;
          const initialIndex = savedIndex >= 0 ? savedIndex : 0;

          prose.style.fontSize = sizes[initialIndex];
          activate(sizeBtns[initialIndex]);

          sizeBtns.forEach((btn, i) => {
            btn.addEventListener("click", () => {
              prose.style.fontSize = sizes[i];
              localStorage.setItem("blog-size", sizes[i]);
              sizeBtns.forEach(deactivate);
              activate(btn);
            });
          });
        }

        document.addEventListener("astro:page-load", initBlogControls);
      </script>
    </article>

    <Footer />
  </div>
</Layout>
